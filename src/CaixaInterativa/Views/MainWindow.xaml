<Window x:Class="CaixaInterativa.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caixa de Areia Interativa"
        Height="720" Width="1280"
        MinHeight="560" MinWidth="960"
        Background="{StaticResource PanelBg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Botão grande, para uso rápido antes da aula. -->
        <Style x:Key="BotaoGrande" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoGrande}">
            <Setter Property="Background" Value="#FF0E5C7A"/>
            <Setter Property="BorderBrush" Value="#FF1B87B0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="318"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Semáforo de estado -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14"
                Background="#FF15151B" CornerRadius="6" Padding="16,13">
            <DockPanel>
                <Ellipse x:Name="LuzEstado" Width="16" Height="16"
                         DockPanel.Dock="Left" Margin="0,0,13,0"
                         Fill="#FF6B6B78" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtEstadoDetalhe" DockPanel.Dock="Right"
                           VerticalAlignment="Center" Opacity="0.55" FontSize="12"
                           Margin="16,0,0,0"/>
                <TextBlock x:Name="TxtEstado" Text="Parado"
                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Painel esquerdo: acoes fixas no topo, conteudo rolavel no meio,
             suporte fixo embaixo. Numa tela de 720px o conteudo nao cabe todo,
             e os dois botoes principais nao podem sumir na rolagem. -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Button x:Name="BtnLigar" Click="OnLigar"
                        Style="{StaticResource BotaoPrimario}"
                        Content="▶  Ligar a caixa"/>

                <Button x:Name="BtnProjetar" Click="OnToggleProjection"
                        Style="{StaticResource BotaoGrande}"
                        Content="🖵  Abrir projeção"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="0,10,0,0">
                <StackPanel>

                <StackPanel x:Name="PainelSimples">
                    <Border Background="#FF15151B" CornerRadius="5" Padding="13">
                        <StackPanel>
                            <TextBlock Text="CALIBRAÇÃO" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="TxtCalibResumo" TextWrapping="Wrap"
                                       Text="Ainda não calibrada." Margin="0,0,0,10"/>
                            <Button x:Name="BtnCalibrar" Click="OnCalibrate"
                                    Style="{StaticResource BotaoGrande}"
                                    Content="Nivelar e calibrar"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="11"
                                       Margin="0,7,0,0"
                                       Text="Alise a areia, tire as mãos da caixa e toque no botão. A calibração fica salva para as próximas aulas."/>
                        </StackPanel>
                    </Border>


                    <Border Background="#FF15151B" CornerRadius="5" Padding="13"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ENCHENTE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="11"
                                       Margin="0,0,0,10"
                                       Text="Os estudantes constroem o território. Quando estiver pronto, faça chover."/>

                            <Button x:Name="BtnChuva" Click="OnChuva"
                                    Style="{StaticResource BotaoPrimario}"
                                    Content="🌧  Fazer chover"/>

                            <TextBlock Text="Intensidade" FontSize="12" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CmbIntensidade" SelectedIndex="1">
                                <ComboBoxItem Content="Garoa"/>
                                <ComboBoxItem Content="Chuva forte"/>
                                <ComboBoxItem Content="Tempestade"/>
                            </ComboBox>

                            <TextBlock Text="Cobertura do terreno" FontSize="12" Margin="0,10,0,0"/>
                            <ComboBox x:Name="CmbCobertura" SelectedIndex="0"
                                      SelectionChanged="OnCoberturaChanged">
                                <ComboBoxItem Content="Mata preservada"/>
                                <ComboBoxItem Content="Desmatado"/>
                                <ComboBoxItem Content="Área queimada"/>
                                <ComboBoxItem Content="Cidade no vale, mata na encosta"/>
                                <ComboBoxItem Content="Tudo impermeabilizado"/>
                                <ComboBoxItem Content="Solo arenoso"/>
                                <ComboBoxItem Content="Solo argiloso"/>
                            </ComboBox>

                            <TextBlock x:Name="TxtAguaStatus" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,10,0,0"
                                       Text="Sem água na caixa."/>

                            <Button x:Name="BtnSecar" Click="OnSecar"
                                    Content="Secar a caixa" Margin="0,8,0,0"/>

                            <Border Background="#FF1B1B22" CornerRadius="4" Padding="10"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="COMPARAÇÃO" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtComparacao" TextWrapping="Wrap"
                                               FontSize="11" Opacity="0.85"
                                               Text="Faça chover em duas coberturas diferentes para comparar."/>
                                    <Button x:Name="BtnLimparComparacao" Click="OnLimparComparacao"
                                            Content="Limpar comparação" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>


                    <Border Background="#FF15151B" CornerRadius="5" Padding="13"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="TERREMOTO" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="11"
                                       Margin="0,0,0,10"
                                       Text="O tremor depende do solo e da encosta: a mesma magnitude poupa a rocha e destrói o solo mole."/>

                            <Button x:Name="BtnTremor" Click="OnTremor"
                                    Style="{StaticResource BotaoPrimario}"
                                    Content="⚡  Provocar terremoto"/>

                            <TextBlock Text="Magnitude" FontSize="12" Margin="0,8,0,0"/>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock x:Name="LblMagnitude" DockPanel.Dock="Right"
                                           Width="34" TextAlignment="Right" Opacity="0.75"/>
                                <Slider x:Name="SldMagnitude" Minimum="3" Maximum="8" Value="6"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        ValueChanged="OnMagnitudeChanged"/>
                            </DockPanel>

                            <TextBlock x:Name="TxtSismoStatus" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,8,0,0"
                                       Text="Nenhum abalo registrado."/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF15151B" CornerRadius="5" Padding="13"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="APARÊNCIA DO MAPA" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,0,0,9"/>

                            <TextBlock Text="Altura das montanhas" FontSize="12"/>
                            <DockPanel Margin="0,3,0,9">
                                <TextBlock x:Name="LblMaxHeight" DockPanel.Dock="Right"
                                           Width="52" TextAlignment="Right" Opacity="0.7"/>
                                <Slider x:Name="SldMaxHeight" Minimum="20" Maximum="400" Value="120"
                                        ValueChanged="OnSettingChanged"/>
                            </DockPanel>

                            <TextBlock Text="Profundidade dos vales" FontSize="12"/>
                            <DockPanel Margin="0,3,0,9">
                                <TextBlock x:Name="LblMinHeight" DockPanel.Dock="Right"
                                           Width="52" TextAlignment="Right" Opacity="0.7"/>
                                <Slider x:Name="SldMinHeight" Minimum="-300" Maximum="0" Value="-80"
                                        ValueChanged="OnSettingChanged"/>
                            </DockPanel>

                            <TextBlock Text="Linhas de altitude" FontSize="12"/>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock x:Name="LblContour" DockPanel.Dock="Right"
                                           Width="52" TextAlignment="Right" Opacity="0.7"/>
                                <Slider x:Name="SldContour" Minimum="0" Maximum="60" Value="15"
                                        ValueChanged="OnSettingChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- MODO AVANÇADO -->
                <Expander x:Name="ExpAvancado" Header="Ajustes técnicos"
                          Foreground="{StaticResource PanelFg}" Margin="0,14,0,0"
                          Expanded="OnAvancadoToggled" Collapsed="OnAvancadoToggled">
                    <StackPanel Margin="0,10,0,0">

                        <GroupBox Header="Sensor">
                            <StackPanel>
                                <TextBlock x:Name="SensorStatus" TextWrapping="Wrap"
                                           Margin="0,0,0,8" Text="Verificando sensor..."/>
                                <Button x:Name="BtnDetect" Click="OnDetect" Content="Procurar Kinect"/>
                                <Button x:Name="BtnStartKinect" Click="OnStartKinect" Content="Usar Kinect"/>
                                <Button x:Name="BtnStartSim" Click="OnStartSimulator" Content="Usar simulador"/>
                                <Button x:Name="BtnParar" Click="OnParar" Content="Parar"/>
                                <CheckBox x:Name="ChkNearMode" IsChecked="True"
                                          Content="Near mode (modelo 1517)"/>
                                <CheckBox x:Name="ChkFlatSim" Content="Simulador: areia plana"
                                          Checked="OnFlatSimChanged" Unchecked="OnFlatSimChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Inicialização">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoStart"
                                          Content="Ligar sozinho ao abrir"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ChkAutoCalib"
                                          Content="Carregar calibração salva"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ChkAutoReconnect"
                                          Content="Reconectar sozinho se o sensor cair"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <Button x:Name="BtnEsquecerCalib" Click="OnResetCalibration"
                                        Content="Apagar calibração salva"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Projeção">
                            <StackPanel>
                                <Label Content="Monitor do projetor"/>
                                <ComboBox x:Name="CmbScreen" SelectionChanged="OnScreenChanged"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.6" FontSize="11"
                                           Text="Na janela de projeção: setas alinham, G mostra a grade, S salva."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Estabilidade da leitura">
                            <StackPanel>
                                <Label Content="Suavização espacial"/>
                                <DockPanel>
                                    <TextBlock x:Name="LblBlur" DockPanel.Dock="Right" Width="44"
                                               TextAlignment="Right" Opacity="0.7"/>
                                    <Slider x:Name="SldBlur" Minimum="0" Maximum="10" Value="3"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="OnSettingChanged"/>
                                </DockPanel>
                                <Label Content="Estabilidade temporal"/>
                                <DockPanel>
                                    <TextBlock x:Name="LblAlpha" DockPanel.Dock="Right" Width="44"
                                               TextAlignment="Right" Opacity="0.7"/>
                                    <Slider x:Name="SldAlpha" Minimum="0.02" Maximum="1.0" Value="0.15"
                                            ValueChanged="OnSettingChanged"/>
                                </DockPanel>
                                <CheckBox x:Name="ChkHillshade" IsChecked="True"
                                          Content="Sombreamento de relevo"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Configuração">
                            <StackPanel>
                                <Button x:Name="BtnSave" Click="OnSave" Content="Salvar configuração"/>
                                <TextBlock x:Name="ConfigPath" TextWrapping="Wrap"
                                           Opacity="0.5" FontSize="10"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- Suporte e identidade: fixos, para estarem sempre à mão quando
                 algo dá errado numa aula. -->
            <Border Grid.Row="2" BorderBrush="#FF2C2C36" BorderThickness="0,1,0,0"
                    Padding="2,12,2,0" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                   Opacity="0.9">
                            <Hyperlink x:Name="LnkPagina" RequestNavigate="OnAbrirLink"
                                       NavigateUri="https://luisfilipegdc.com.br/caixa-de-areia">Projeto</Hyperlink>
                            <Run Text="  ·  " Foreground="#FF5A5A66"/>
                            <Hyperlink x:Name="LnkSuporte" RequestNavigate="OnAbrirLink">Suporte</Hyperlink>
                            <Run Text="  ·  " Foreground="#FF5A5A66"/>
                            <Hyperlink x:Name="LnkGithub" RequestNavigate="OnAbrirLink"
                                       NavigateUri="https://github.com/luisfilipegdc/caixadeareia">GitHub</Hyperlink>
                        </TextBlock>

                        <!-- A versão é o primeiro dado que o suporte pede; fica em
                             destaque para ser lida de relance, sem procurar. -->
                        <DockPanel>
                            <TextBlock x:Name="TxtVersao" Text="v1.0.0"
                                       DockPanel.Dock="Left" VerticalAlignment="Center"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"
                                       Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtAssinatura" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       FontSize="10" Opacity="0.5"/>
                        </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Prévia -->
        <Border Grid.Column="1" Grid.Row="1" Background="#FF0E0E11" CornerRadius="6">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Orientação quando não há nada para mostrar -->
                <Border x:Name="PainelAjuda" Background="#EE0E0E11" CornerRadius="6">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="440">
                        <TextBlock Text="Caixa de Areia Interativa"
                                   FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtAjuda" TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="14" Opacity="0.75" LineHeight="23"
                                   Text="Toque em “Ligar a caixa” para começar."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="#FF15151B" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Pronto."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="FpsText" Opacity="0.6"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
