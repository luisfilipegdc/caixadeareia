<Window x:Class="CaixaInterativa.Views.ProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projecao - Caixa Interativa"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        ShowInTaskbar="False"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- A imagem topografica. O RenderTransform e' o alinhamento fino
             com a caixa fisica, ajustado pelo teclado e salvo no config. -->
        <Image x:Name="Projected"
               RenderTransformOrigin="0.5,0.5"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Scale"/>
                    <RotateTransform x:Name="Rotate"/>
                    <TranslateTransform x:Name="Translate"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- Grade de alinhamento: usada para casar a borda da projecao com a
             borda de madeira da caixa antes de por areia. Tecla G. -->
        <Canvas x:Name="AlignmentGrid" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Números da simulação sobre a própria projeção.
             A turma olha para a caixa, não para o notebook — se o resultado só
             aparece no painel do professor, ninguém vê o que acabou de acontecer. -->
        <Border x:Name="PainelDados"
                Background="#D9000000"
                CornerRadius="8"
                Padding="26,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="28"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="DadosTitulo" Text="ENCHENTE"
                           FontSize="15" FontWeight="Bold" Foreground="#FF7FCFE8"
                           Margin="0,0,0,14"/>

                <StackPanel x:Name="DadosLinhas"/>

                <TextBlock x:Name="DadosRodape" Foreground="#FFB9C4C9"
                           FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                           MaxWidth="330"/>
            </StackPanel>
        </Border>

        <Border x:Name="HelpPanel"
                Background="#CC000000"
                CornerRadius="6"
                Padding="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24">
            <StackPanel>
                <TextBlock Text="ALINHAMENTO DA PROJECAO" FontWeight="Bold" Foreground="#FF4FA3E3" Margin="0,0,0,8"/>
                <TextBlock Foreground="White" FontFamily="Consolas" LineHeight="20">
                    Setas          mover  (Shift = 10x)<LineBreak/>
                    + / -          escala uniforme<LineBreak/>
                    Ctrl + Setas   escala X / Y<LineBreak/>
                    R / E          girar<LineBreak/>
                    H / V          espelhar horiz. / vert.<LineBreak/>
                    G              grade de alinhamento<LineBreak/>
                    D              dados da simulação<LineBreak/>
                    C              calibrar plano-base<LineBreak/>
                    S              salvar configuracao<LineBreak/>
                    F1             mostrar/ocultar esta ajuda<LineBreak/>
                    Esc            fechar projecao
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
