<Application x:Class="CaixaInterativa.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FF1E1E22"/>
        <SolidColorBrush x:Key="PanelFg" Color="#FFE8E8EC"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4FA3E3"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="Padding" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <!-- Foreground e' herdado em WPF, e o Foreground de destaque do GroupBox desce
             para tudo que estiver dentro dele. Sem Background/Foreground explicitos aqui,
             o texto do botao herdava o azul do cabecalho e ficava ilegivel sobre o chrome
             cinza-claro padrao. O ControlTemplate tambem garante que o estado desabilitado
             seja visivelmente diferente, e nao apenas "apagado igual ao normal". -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#FFE8E8EC"/>
            <Setter Property="Background" Value="#FF2D2D35"/>
            <Setter Property="BorderBrush" Value="#FF4A4A57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Label"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF3C3C48"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF4FA3E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF23232A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF212127"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF33333C"/>
                                <Setter TargetName="Label" Property="TextBlock.Foreground" Value="#FF6B6B78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mesma razao: sem Foreground explicito o texto selecionado herda o azul do
             GroupBox e some sobre o fundo claro do ComboBox. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF1A1A1E"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- O azul padrão do Hyperlink é escuro demais para este fundo. -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF7FCFE8"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
