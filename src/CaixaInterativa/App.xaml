<Application x:Class="CaixaInterativa.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FF1E1E22"/>
        <SolidColorBrush x:Key="PanelFg" Color="#FFE8E8EC"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4FA3E3"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="Padding" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <!-- Foreground e' herdado em WPF, e o Foreground de destaque do GroupBox desce
             para tudo que estiver dentro dele. Sem Background/Foreground explicitos aqui,
             o texto do botao herdava o azul do cabecalho e ficava ilegivel sobre o chrome
             cinza-claro padrao. O ControlTemplate tambem garante que o estado desabilitado
             seja visivelmente diferente, e nao apenas "apagado igual ao normal". -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#FFE8E8EC"/>
            <Setter Property="Background" Value="#FF2D2D35"/>
            <Setter Property="BorderBrush" Value="#FF4A4A57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Label"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF3C3C48"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF4FA3E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF23232A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF212127"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF33333C"/>
                                <Setter TargetName="Label" Property="TextBlock.Foreground" Value="#FF6B6B78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: três camadas tiveram que ser vencidas para o texto aparecer.
             1) O campo fechado herdava o azul do GroupBox.
             2) Os itens ficam num Popup, árvore visual separada.
             3) E, decisivo: o tema do WPF define um ItemContainerStyle para o ComboBox,
                que tem precedência sobre qualquer Style implícito em Application.Resources.
                Por isso o template dos itens precisa vir daqui, de dentro do ComboBox —
                estilo implícito e até Foreground no próprio elemento eram ignorados,
                porque o template do tema não consulta o Foreground do item. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF15151B"/>
            <Setter Property="Background" Value="#FFEFEFF2"/>
            <Setter Property="BorderBrush" Value="#FF4A4A57"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="13"/>

            <!-- O campo fechado desenha o item selecionado num TextBlock interno, que
                 herda o Style implícito de TextBlock deste arquivo — claro, para o painel
                 escuro. Sobre o fundo claro do ComboBox isso vira texto invisível, e o
                 campo parece vazio. O ItemTemplate fixa a cor onde ela é realmente usada. -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FF15151B"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FF15151B"/>
                        <Setter Property="Background" Value="#FFFFFFFF"/>
                        <Setter Property="Padding" Value="9,7"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Fundo"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Fundo" Property="Background" Value="#FF0E5C7A"/>
                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Fundo" Property="Background" Value="#FFD6E9F2"/>
                                            <Setter Property="Foreground" Value="#FF0B3F52"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- O cabeçalho do Expander também herdava a cor do container e ficava apagado. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- O azul padrão do Hyperlink é escuro demais para este fundo. -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF7FCFE8"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
