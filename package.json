{
  "name": "caixa-de-areia-interativa",
  "version": "0.1.0",
  "description": "Caixa de areia interativa (AR Sandbox) que roda no navegador, com Kinect via ponte WebSocket",
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "web": "node servidor-local.js",
    "ponte": "node ponte/ponte.js",
    "ponte:simulada": "node ponte/ponte.js --simulado",
    "diagnostico": "node ponte/diagnostico.js",
    "app": "electron .",
    "empacotar": "electron-builder --win --x64"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "kinect2": "^0.3.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "author": "Projeto Caixa de Areia Interativa",
  "build": {
    "appId": "br.caixadeareia.interativa",
    "productName": "Caixa de Areia Interativa",
    "files": [
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "css/**",
      "src/**",
      "cenarios/**",
      "ponte/**",
      "app/**",
      "servidor-local.js"
    ],
    "asarUnpack": [
      "node_modules/kinect2/**",
      "node_modules/freenect/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CaixaDeAreia-${version}.exe"
    }
  },
  "license": "GPL-2.0-or-later"
}
